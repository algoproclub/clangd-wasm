{
  "name": "@algoproclub/clangd-wasm",
  "version": "0.1.0",
  "description": "Prebuilt browser clangd runtime and AArch64 GNU C++ headers for AlgoPro-compatible editors.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/browser.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/browser.js"
    },
    "./support": {
      "types": "./lib/support.d.ts",
      "import": "./lib/support.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algoproclub/clangd-wasm.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "lib",
    "assets",
    "README.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepackOnly": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "acquire:dependencies": "bash ./build/acquire-dependencies.sh",
    "fetch:sysroot": "bash ./build/fetch-sysroot.sh",
    "build:engine": "bash ./build/build-engine.sh",
    "build:index": "bash ./build/build-system-index.sh",
    "capture:sysroot": "bash ./build/capture-sysroot.sh",
    "build:artifacts": "npm run build:engine && npm run build:index",
    "pack:check": "npm test && npm run verify:assets && npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "vscode-jsonrpc": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0 WITH LLVM-exception"
}
