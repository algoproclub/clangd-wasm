# Pinned build inputs. Update only as one reviewed artifact change.
LLVM_REVISION=llvmorg-23.1.1
EMSDK_VERSION=6.0.9
TARGET_TRIPLE=aarch64-linux-gnu

# Release CI captures these from the actual execution image.
SYSROOT_DIR=
GCC_VERSION=

# clangd needs LLVM thread support to configure. The browser runtime itself
# uses no Emscripten pthreads and sets AsyncThreadsCount=0.
LLVM_ENABLE_LTO=Thin
CLANGD_DECISION_FOREST=ON
LLVM_ENABLE_ZLIB=OFF
