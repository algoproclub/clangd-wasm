# Pinned build inputs. Update only as one reviewed artifact change.
LLVM_REPOSITORY=https://github.com/llvm/llvm-project.git
LLVM_REVISION=llvmorg-23.1.1
EMSDK_REPOSITORY=https://github.com/emscripten-core/emsdk.git
EMSDK_VERSION=6.0.9
TARGET_TRIPLE=aarch64-linux-gnu

# Defaults are deliberately inside build/, which is ignored. A release may
# override these environment variables to use a pre-populated cache.
LLVM_SRC=${LLVM_SRC:-}
EMSDK=${EMSDK:-}
BUILD_DEPENDENCIES_DIR=${BUILD_DEPENDENCIES_DIR:-}

# Release CI captures these from the actual execution image.
SYSROOT_DIR=${SYSROOT_DIR:-}
GCC_VERSION=${GCC_VERSION:-}

# clangd needs LLVM thread support to configure. The browser runtime itself
# uses no Emscripten pthreads and sets AsyncThreadsCount=0.
LLVM_ENABLE_LTO=Thin
CLANGD_DECISION_FOREST=ON
LLVM_ENABLE_ZLIB=OFF
